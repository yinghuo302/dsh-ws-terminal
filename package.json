{
  "name": "@local/dsh-ws-terminal",
  "version": "0.1.0",
  "private": true,
  "description": "WebSocket PTY terminal pages for DSH Better Sidebar",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js"
  },
  "files": ["index.js", "terminal-registry.js", "trust-fence.js", "lib/client.js", "cordis.patch.yml", "README.md"],
  "scripts": { "build": "tsdown" },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "tsdown": "^0.22.14"
  },
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.24.1",
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["dsh-better-sidebar"]
    }
  }
}
